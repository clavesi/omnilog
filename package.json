{
	"name": "omnilog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:push:neon": "node scripts/drizzle-remote.mjs push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:neon": "node scripts/drizzle-remote.mjs migrate",
		"db:studio": "drizzle-kit studio",
		"b:check": "biome check",
		"b:format": "biome format --write",
		"b:lint": "biome lint --write",
		"b:all": "biome check --write",
		"backfill:titles": "node scripts/backfill-anime-manga-titles.mjs",
		"backfill:titles:neon": "node scripts/backfill-anime-manga-titles.mjs --remote"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"better-auth": "^1.6.25",
		"postgres": "^3.4.9",
		"resend": "^6.18.0"
	}
}
